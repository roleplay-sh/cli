{
  "name": "@roleplay-sh/cli",
  "version": "0.1.1",
  "description": "Social-engineering regression tests for AI agents.",
  "type": "module",
  "license": "MIT",
  "author": "MARAM TECH VENTURES LTD",
  "keywords": [
    "ai",
    "agents",
    "security",
    "redteam",
    "social-engineering",
    "evals",
    "testing",
    "cli",
    "llm"
  ],
  "homepage": "https://github.com/roleplay-sh/cli#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/roleplay-sh/cli.git"
  },
  "bugs": {
    "url": "https://github.com/roleplay-sh/cli/issues"
  },
  "packageManager": "pnpm@9.15.4",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "roleplay": "./dist/cli.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "examples",
    "README.md",
    "LICENSE",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "CHANGELOG.md",
    "RELEASE.md",
    ".env.example"
  ],
  "scripts": {
    "dev": "tsx src/cli.ts",
    "roleplay": "tsx src/cli.ts",
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "package:smoke": "node scripts/smoke-package.mjs",
    "format": "prettier --write .",
    "start": "node dist/cli.js"
  },
  "dependencies": {
    "@oclif/core": "^4.2.10",
    "boxen": "^8.0.1",
    "chalk": "^5.4.1",
    "dotenv": "^16.4.7",
    "execa": "^9.5.2",
    "nanoid": "^5.0.9",
    "ora": "^8.1.1",
    "pino": "^9.6.0",
    "yaml": "^2.7.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.5",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.1",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20"
  }
}
